@using ATI.Revenue.Domain.Enums
@using ATI.Revenue.Application.Products.Dtos
@using System.Collections.Generic
@using ATI.Revenue.Web.PageModel.ProcedureTransactions
@model CreateOrEditProcedureTransactionModalViewModel

@{
    var products = (List<ProductDto>)ViewBag.Products;
    var existingLines = Model.ProcedureTransaction?.Products ?? new List<ATI.Revenue.Application.ProcedureTransactions.Dtos.CreateOrEditProcedureTransactionProductDto>();
}

<div class="modal-header">
    <h5 class="modal-title">
        <span>@(Model.IsEditMode ? L("EditCase") : L("CreateCase"))</span>
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
</div>

<div class="modal-body">
    <form name="ProcedureTransactionCreateOrEditForm" role="form" novalidate class="form-validation">
        <input type="hidden" name="Id" value="@(Model.ProcedureTransaction?.Id ?? 0)" />

        <div class="row">
            <div class="col-md-4 mb-5">
                <label class="form-label required" for="CaseNumber">@L("CaseNumber")</label>
                <input class="form-control" type="text" name="CaseNumber" id="CaseNumber"
                       value="@Model.ProcedureTransaction?.CaseNumber" required maxlength="50" />
            </div>
            <div class="col-md-4 mb-5">
                @* The hospital leads: it narrows the physician list below and prices the
                   devices. *@
                <label class="form-label" for="HospitalId">@L("Hospital")</label>
                @* Locked users get their one hospital with no blank option, so it is
                   genuinely preselected rather than merely offered. *@
                <select class="form-control" id="HospitalId" name="HospitalId">
                    @if (!(bool)ViewBag.IsPhysicianRestricted)
                    {
                        <option value="">@L("SelectHospital")</option>
                    }
                    @foreach (var hospital in ViewBag.Hospitals)
                    {
                        var isSelected = (bool)ViewBag.IsPhysicianRestricted
                            || (Model.ProcedureTransaction != null && hospital.Value == Model.ProcedureTransaction.HospitalId.ToString());
                        <option value="@hospital.Value" selected="@isSelected">@hospital.Text</option>
                    }
                </select>
                <small class="form-text text-muted">@L("HospitalDrivesPhysicianList")</small>
            </div>
            <div class="col-md-4 mb-5">
                <label class="form-label required" for="ProcedureDate">@L("Date")</label>
                <input class="form-control" type="date" name="ProcedureDate" id="ProcedureDate"
                       value="@(Model.ProcedureTransaction?.ProcedureDate.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))" required />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-5">
                <label class="form-label required" for="PhysicianId">@L("Physician")</label>
                <select class="form-control" id="PhysicianId" name="PhysicianId" required>
                    @if (!(bool)ViewBag.IsPhysicianRestricted)
                    {
                        <option value="">@L("SelectPhysician")</option>
                    }
                    @foreach (var physician in ViewBag.Physicians)
                    {
                        var isSelected = (bool)ViewBag.IsPhysicianRestricted
                            || (Model.ProcedureTransaction != null && physician.Value == Model.ProcedureTransaction.PhysicianId.ToString());
                        <option value="@physician.Value" selected="@isSelected">@physician.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-6 mb-5">
                <label class="form-label required">@L("ImplantType")</label>
                <div class="pt-2">
                    @{
                        var isDeNovo = Model.ProcedureTransaction == null
                            || Model.ProcedureTransaction.ImplantType == ImplantType.DeNovo;
                    }
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="ImplantType" id="ImplantTypeDeNovo"
                               value="@((int)ImplantType.DeNovo)" @(isDeNovo ? "checked" : "") required />
                        <label class="form-check-label" for="ImplantTypeDeNovo">NEW (De Novo)</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="ImplantType" id="ImplantTypeGenChange"
                               value="@((int)ImplantType.GenChange)" @(!isDeNovo ? "checked" : "") />
                        <label class="form-check-label" for="ImplantTypeGenChange">GEN CHANGE</label>
                    </div>
                </div>
                <small class="form-text text-muted">@L("EveryDeviceMustMatchImplantType")</small>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-5">
                <label class="form-label required" for="Status">@L("CaseStatus")</label>
                <select class="form-control" id="Status" name="Status" required>
                    @{
                        var statuses = new[] { "Open", "Scheduled", "Completed", "Billed", "Paid", "Closed" };
                        var currentStatus = (int)(Model.ProcedureTransaction?.Status ?? CaseStatus.Open);
                    }
                    @for (var i = 0; i < statuses.Length; i++)
                    {
                        var value = i + 1;
                        <option value="@value" selected="@(currentStatus == value)">@statuses[i]</option>
                    }
                </select>
                <small class="form-text text-muted">@L("StatusDoesNotAffectReportsYet")</small>
            </div>
            <div class="col-md-6 mb-5">
                <label class="form-label" for="Description">@L("Description")</label>
                <textarea class="form-control" name="Description" id="Description" rows="2"
                          maxlength="1000">@Model.ProcedureTransaction?.Description</textarea>
            </div>
        </div>

        @* A procedure can involve two or three devices, so products are lines on the case.
           Each option carries its implant type so the form can flag a device that does not
           belong on this case before the server rejects it. *@
        <div class="separator separator-dashed my-4"></div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="mb-0">@L("DevicesUsed")</h6>
            <button type="button" id="AddDeviceLineButton" class="btn btn-sm btn-primary">
                <i class="fa fa-plus"></i> <span>@L("AddDevice")</span>
            </button>
        </div>

        <div class="table-responsive">
            <table class="table table-sm align-middle" id="DeviceLinesTable">
                <thead>
                    <tr class="fw-bold">
                        <th style="width: 45%">@L("Product")</th>
                        <th style="width: 12%">@L("Quantity")</th>
                        <th style="width: 18%">@L("UnitPrice")</th>
                        <th style="width: 18%">@L("LineTotal")</th>
                        <th style="width: 7%"></th>
                    </tr>
                </thead>
                <tbody id="DeviceLinesBody"></tbody>
            </table>
        </div>

        <div id="DeviceLinesEmpty" class="text-muted small mb-3" style="display: none;">
            @L("NoDevicesYet")
        </div>

        <div class="row mt-4">
            <div class="col-md-6 offset-md-6 mb-3">
                <label class="form-label" for="TotalAmount">@L("TransactionAmount")</label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input class="form-control" type="number" name="TotalAmount" id="TotalAmount"
                           value="@(Model.ProcedureTransaction?.TotalAmount ?? 0)" step="0.01" min="0" />
                    <button type="button" class="btn btn-light" id="RecalculateTotalButton" title="@L("RecalculateFromDevices")">
                        <i class="fa fa-sync"></i>
                    </button>
                </div>
                <small class="form-text text-muted">@L("TotalOverrideHint")</small>
            </div>
        </div>
    </form>
</div>

@* Product catalogue and any existing lines, handed to the script as data rather than
   rebuilt per row in Razor. *@
<script type="application/json" id="DeviceLineProducts">
    @Html.Raw(Json.Serialize(products.Select(p => new
    {
        id = p.Id,
        name = string.IsNullOrWhiteSpace(p.ProductCode) ? p.Name : p.ProductCode + " - " + p.Name,
        implantType = p.ImplantType.HasValue ? (int?)p.ImplantType.Value : null,
        basePrice = p.BasePrice
    })))
</script>
<script type="application/json" id="DeviceLineExisting">
    @Html.Raw(Json.Serialize(existingLines.Select(l => new
    {
        id = l.Id,
        productId = l.ProductId,
        quantity = l.Quantity,
        unitPrice = l.UnitPrice
    })))
</script>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L("Cancel")</button>
    <button type="button" class="btn btn-primary save-button">
        <i class="fa fa-save"></i> <span>@L("Save")</span>
    </button>
</div>

<script src="~/view-resources/Areas/Revenue/Views/ProcedureTransactions/_CreateOrEditModal.js" asp-append-version="true"></script>
