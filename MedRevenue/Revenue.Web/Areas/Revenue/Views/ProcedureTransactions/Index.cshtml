@{
    ViewData["Title"] = "Revenue Transactions";
}

@section Scripts
{
    <script>
        // Set current month on page load
        $('#MonthFilter').val('@ViewBag.CurrentMonth');
    </script>
    <script src="~/view-resources/Areas/Revenue/Views/ProcedureTransactions/Index.js" asp-append-version="true"></script>
}

<div class="app-toolbar py-3 py-lg-6" id="kt_app_toolbar">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
            <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">
                @L("RevenueTransactions")
            </h1>
            <span class="text-muted me-4">@L("RevenueTransactionsHeaderInfo")</span>
        </div>
        <div class="d-flex align-items-center">
            <button id="CreateNewTransactionButton" class="btn btn-primary">
                <i class="fa fa-plus btn-md-icon"></i>
                <span class="d-none d-md-inline-block">@L("CreateNew")</span>
            </button>
        </div>
    </div>
</div>

<div class="app-container container-fluid">
    <div class="card">
        <div class="card-body">
            <div class="form">
                <div class="row align-items-center mb-4">
                    <div class="col-xl-12">
                        <div class="mb-5 align-items-center">
                            <div class="input-group">
                                <input type="text" id="ProcedureTransactionsTableFilter" class="form-control" placeholder="@L("SearchWithThreeDot")">
                                <button id="GetProcedureTransactionsButton" class="btn btn-primary" type="submit">
                                    <i class="flaticon-search-1" aria-label="@L("Search")"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="AdvancedAuditFiltersArea" style="display: none" class="row mb-4">
                    <div class="col-xl-3">
                        <div class="mb-5">
                            <label for="YearFilter" class="form-label">@L("Year")</label>
                            <input type="number" id="YearFilter" class="form-control" placeholder="@L("Year")" value="@ViewBag.CurrentYear" />
                        </div>
                    </div>
                    <div class="col-xl-3">
                        <div class="mb-5">
                            <label for="MonthFilter" class="form-label">@L("Month")</label>
                            <select id="MonthFilter" class="form-control">
                                <option value="">@L("AllMonths")</option>
                                <option value="1">@L("January")</option>
                                <option value="2">@L("February")</option>
                                <option value="3">@L("March")</option>
                                <option value="4">@L("April")</option>
                                <option value="5">@L("May")</option>
                                <option value="6">@L("June")</option>
                                <option value="7">@L("July")</option>
                                <option value="8">@L("August")</option>
                                <option value="9">@L("September")</option>
                                <option value="10">@L("October")</option>
                                <option value="11">@L("November")</option>
                                <option value="12">@L("December")</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xl-3">
                        <div class="mb-5">
                            <label for="HospitalFilter" class="form-label">@L("Hospital")</label>
                            <select id="HospitalFilter" class="form-control">
                                <option value="">@L("AllHospitals")</option>
                                @foreach (var hospital in ViewBag.Hospitals)
                                {
                                    <option value="@hospital.Value">@hospital.Text</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-xl-3">
                        <div class="mb-5">
                            <label for="PhysicianFilter" class="form-label">@L("Physician")</label>
                            <select id="PhysicianFilter" class="form-control">
                                <option value="">@L("AllPhysicians")</option>
                                @foreach (var physician in ViewBag.Physicians)
                                {
                                    <option value="@physician.Value">@physician.Text</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-xl-12 text-end">
                        <button id="RefreshTransactionsButton" class="btn btn-primary float-end">
                            <i class="fa fa-sync btn-md-icon"></i>
                            <span class="d-none d-md-inline-block">
                                @L("Refresh")
                            </span>
                        </button>
                    </div>
                </div>
                <div class="row mb-4">
                    <div class="col-xl-12">
                        <span id="ShowAdvancedFiltersSpan" class="text-muted clickable-item">
                            <i class="fa fa-angle-down"></i> @L("ShowAdvancedFilters")
                        </span>
                        <span id="HideAdvancedFiltersSpan" class="text-muted clickable-item" style="display: none">
                            <i class="fa fa-angle-up"></i> @L("HideAdvancedFilters")
                        </span>
                    </div>
                </div>
            </div>

            <div class="align-items-center">
                <table id="ProcedureTransactionsTable" class="table align-middle table-row-dashed fs-6 gy-5 dataTable dtr-inline no-footer" width="100%">
                    <thead>
                        <tr>
                            <th>@L("Actions")</th>
                            <th>@L("Hospital")</th>
                            <th>@L("Physician")</th>
                            <th>@L("Date")</th>
                            <th>@L("Product")</th>
                            <th>@L("ProductCode")</th>
                            <th>@L("ProcedureType")</th>
                            <th>@L("NumberOfCases")</th>
                            <th>@L("BasePrice")</th>
                            <th>@L("TransactionAmount")</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>
