@using ATI.Revenue.Application.Products.Dtos
@model CreateOrEditProductDto

<div class="modal-header">
    <h5 class="modal-title">
        <span>@(Model.Id > 0 ? L("EditProduct") : L("CreateNewProduct"))</span>
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
</div>

<div class="modal-body">
    <form name="ProductCreateOrEditForm" role="form" novalidate class="form-validation">
        <input type="hidden" name="Id" value="@Model.Id" />

        <div class="row">
            <div class="col-md-6 mb-4">
                <label class="form-label required">@L("Name")</label>
                <input class="form-control" type="text" name="Name" id="Name"
                       value="@Model.Name" maxlength="200" required />
            </div>
            <div class="col-md-6 mb-4">
                <label class="form-label">@L("Manufacturer")</label>
                <input class="form-control" type="text" name="Manufacturer" id="Manufacturer"
                       value="@(Model.Manufacturer ?? "")" maxlength="200" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-4">
                <label class="form-label">@L("ModelNo")</label>
                <input class="form-control" type="text" name="ModelNo" id="ModelNo"
                       value="@(Model.ModelNo ?? "")" maxlength="100" />
            </div>
            <div class="col-md-6 mb-4">
                <label class="form-label">@L("Category")</label>
                <select class="form-select" name="ProductCategoryId" id="ProductCategoryId"
                        data-current-category-id="@(Model.ProductCategoryId ?? 0)">
                    <option value="">-- @L("SelectCategory") --</option>
                </select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-4">
                <label class="form-label">@L("ProductCode")</label>
                <input class="form-control" type="text" name="ProductCode" id="ProductCode"
                       value="@Model.ProductCode" maxlength="30" />
            </div>
            <div class="col-md-6 mb-4">
                @* The subcategory decides De Novo vs Gen Change, which the case form
                   validates against, so a product without one cannot be checked. *@
                <label class="form-label">@L("Subcategory")</label>
                <select class="form-select" name="SubproductCategoryId" id="SubproductCategoryId"
                        data-current-subcategory-id="@(Model.SubproductCategoryId ?? 0)">
                    <option value="">-- @L("SelectSubcategory") --</option>
                </select>
            </div>
        </div>

                <div class="row">
            <div class="col-md-6 mb-4">
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox" name="IsSystem" id="IsSystem"
                           value="true" @(Model.IsSystem ? "checked" : "") />
                    <label class="form-check-label" for="IsSystem">@L("IsSystemProduct")</label>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-4">
                @* The price a case falls back to when the hospital has no contracted
                   price. This is the figure the entry form and Rate Chart use. *@
                <label class="form-label">@L("BasePrice")</label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input class="form-control" type="number" name="BasePrice" id="BasePrice"
                           value="@Model.BasePrice" step="0.01" min="0" />
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <label class="form-label required">@L("Cost")</label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input class="form-control" type="number" name="Cost" id="Cost"
                           value="@Model.Cost" step="0.01" min="0" required />
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <label class="form-label required">@L("Price")</label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input class="form-control" type="number" name="Price" id="Price"
                           value="@Model.Price" step="0.01" min="0" required />
                </div>
            </div>
            <div class="col-md-4 mb-4 d-flex align-items-end pb-2">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="IsActive" id="IsActive"
                           value="true" @(Model.IsActive ? "checked" : "") />
                    <input type="hidden" name="IsActive" value="false" />
                    <label class="form-check-label" for="IsActive">@L("IsActive")</label>
                </div>
            </div>
        </div>

        <div class="mb-4">
            <label class="form-label">@L("Description")</label>
            <textarea class="form-control" name="Description" id="Description" rows="3"
                      maxlength="500">@(Model.Description ?? "")</textarea>
        </div>
    </form>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L("Cancel")</button>
    <button type="button" class="btn btn-primary save-button">
        <i class="fa fa-save"></i> <span>@L("Save")</span>
    </button>
</div>

<script src="~/view-resources/Areas/Revenue/Views/Products/_CreateOrEditModal.js" asp-append-version="true"></script>
