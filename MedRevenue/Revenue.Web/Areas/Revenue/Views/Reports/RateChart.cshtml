@{
    ViewData["Title"] = "Rate Chart Report";
}

<div class="app-toolbar py-3 py-lg-6">
    <div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
            <h1 class="page-heading d-flex fw-bold fs-3 flex-column justify-content-center my-0">
                @L("RateChart")
            </h1>
            <span class="text-muted me-4">Products by category, with base and contracted prices</span>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label for="HospitalFilter">Hospital</label>
                        <select id="HospitalFilter" class="form-control">
                            <option value="">@L("AllHospitals")</option>
                            @foreach (var hospital in ViewBag.Hospitals)
                            {
                                <option value="@hospital.Value">@hospital.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="ProductCodeFilter">@L("ProductCode")</label>
                        <select id="ProductCodeFilter" class="form-control">
                            <option value="">@L("AllProductCodes")</option>
                            @foreach (var code in ViewBag.ProductCodes)
                            {
                                <option value="@code.Value">@code.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-auto d-flex align-items-end">
                        <button id="GenerateReportButton" class="btn btn-primary text-nowrap">
                            <i class="fas fa-chart-bar"></i> Generate Report
                        </button>
                        <button id="ExportToExcelButton" class="btn btn-success ms-2 text-nowrap">
                            <i class="fa fa-file-excel"></i> <span>@L("ExportToExcel")</span>
                        </button>
                    </div>
                </div>

                <div id="reportContainer" style="display:none;">
                    <table id="RateChartTable" class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>@L("Hospital")</th>
                                <th>Product Category</th>
                                <th>Product Code</th>
                                <th>Product Name</th>
                                <th>Type</th>
                                <th class="text-end">Base Price</th>
                                <th class="text-end">Contracted Price</th>
                                <th class="text-end">Effective Price</th>
                                <th class="text-center">Units (YTD)</th>
                                <th class="text-center">Cases (YTD)</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/view-resources/Areas/Revenue/Views/Reports/RateChart.js" asp-append-version="true"></script>
}
