@{
    ViewData["Title"] = "Transaction Amount Report";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Transaction Amount - By Physician per Product Type</h3>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-2">
                        <label for="YearFilter">Year *</label>
                        <input type="number" id="YearFilter" class="form-control" value="@ViewBag.CurrentYear" />
                    </div>
                    <div class="col-md-3">
                        <label for="PhysicianFilter">Physician (Optional)</label>
                        <select id="PhysicianFilter" class="form-control">
                            <option value="">All Physicians</option>
                            @foreach (var physician in ViewBag.Physicians)
                            {
                                <option value="@physician.Value">@physician.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="ProductCategoryFilter">Product Category (Optional)</label>
                        <select id="ProductCategoryFilter" class="form-control">
                            <option value="">All Categories</option>
                            @foreach (var category in ViewBag.ProductCategories)
                            {
                                <option value="@category.Value">@category.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-auto d-flex align-items-end">
                        <button id="GenerateReportButton" class="btn btn-primary text-nowrap">
                            <i class="fas fa-chart-bar"></i> Generate Report
                        </button>
                        <button id="ExportToExcelButton" class="btn btn-success ms-2 text-nowrap">
                            <i class="fa fa-file-excel"></i> <span>@L("ExportToExcel")</span>
                        </button>
                    </div>
                </div>

                <div id="reportContainer" style="display:none;">
                    <table id="TransactionAmountTable" class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Physician</th>
                                <th>Product Category</th>
                                <th>Procedure Type</th>
                                <th>Total Cases</th>
                                <th class="text-center">Units</th>
                                <th>Total Amount</th>
                                <th>Average Amount</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/view-resources/Areas/Revenue/Views/Reports/TransactionAmount.js" asp-append-version="true"></script>
}
