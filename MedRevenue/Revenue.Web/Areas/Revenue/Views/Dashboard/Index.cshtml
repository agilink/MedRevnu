@{
    ViewData["Title"] = L("RevenueDashboard");
}

@section Scripts
{
    <script src="~/view-resources/Areas/Revenue/Views/Dashboard/Index.js" asp-append-version="true"></script>
}

<div class="app-toolbar py-3 py-lg-6" id="kt_app_toolbar">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
            <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">
                @L("RevenueDashboard")
            </h1>
            <span class="text-muted me-4">@L("RevenueDashboardHeaderInfo")</span>
        </div>
    </div>
</div>

<div class="app-container container-fluid" id="RevenueDashboardContent">

    <!-- Period filter. Defaults to the current month, so the page is meaningful before
         anything is chosen. -->
    <div class="card mb-5">
        <div class="card-body py-4">
            <div class="row align-items-end g-3">
                <div class="col-sm-6 col-lg-3">
                    <label for="FromDate" class="form-label">@L("FromDate")</label>
                    <input type="date" id="FromDate" class="form-control" value="@ViewBag.DefaultFromDate" />
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label for="ToDate" class="form-label">@L("ToDate")</label>
                    <input type="date" id="ToDate" class="form-control" value="@ViewBag.DefaultToDate" />
                </div>
                <div class="col-sm-8 col-lg-4">
                    <label for="HospitalFilter" class="form-label">@L("Hospital")</label>
                    @* A physician is confined to one hospital, so "All Hospitals" is not
                       on offer - it would suggest a view they can never have. Their own
                       hospital is the only entry and comes preselected. *@
                    <select id="HospitalFilter" class="form-select">
                        @if (!(bool)ViewBag.IsHospitalLocked)
                        {
                            <option value="">@L("AllHospitals")</option>
                        }
                        else if ((bool)ViewBag.HasNoHospital)
                        {
                            <option value="">@L("NoHospitalAssigned")</option>
                        }
                        @foreach (var hospital in ViewBag.Hospitals)
                        {
                            <option value="@hospital.Value" selected="@hospital.Selected">@hospital.Text</option>
                        }
                    </select>
                </div>
                <div class="col-sm-4 col-lg-2">
                    @* w-100 so the button matches the column, and no size class so its
                       height matches the inputs beside it. *@
                    <button type="button" id="ApplyFilters" class="btn btn-primary w-100">
                        <i class="fa fa-search btn-md-icon"></i>@L("Apply")
                    </button>
                </div>
            </div>

            @* The presets are shortcuts, not primary controls, so they sit on their own
               line where there is room for all four on one row - crammed into a quarter
               column their labels wrapped to two lines and doubled the row height. *@
            <div class="d-flex justify-content-end mt-3">
                <div class="btn-group" role="group">
                    <button type="button" class="btn btn-sm btn-light text-nowrap period-preset" data-preset="thisMonth">@L("ThisMonth")</button>
                    <button type="button" class="btn btn-sm btn-light text-nowrap period-preset" data-preset="lastMonth">@L("LastMonth")</button>
                    <button type="button" class="btn btn-sm btn-light text-nowrap period-preset" data-preset="thisQuarter">@L("ThisQuarter")</button>
                    <button type="button" class="btn btn-sm btn-light text-nowrap period-preset" data-preset="thisYear">@L("ThisYear")</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Headline figures -->
    <div class="row g-5 mb-5">
        <div class="col-sm-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body d-flex flex-column justify-content-center">
                    <span class="text-muted fw-semibold fs-7">@L("TotalCases")</span>
                    <span class="text-dark fw-bold fs-2hx" id="KpiTotalCases">-</span>
                    <span class="text-muted fs-8" id="KpiTotalUnits"></span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body d-flex flex-column justify-content-center">
                    <span class="text-muted fw-semibold fs-7">@L("TotalSold")</span>
                    <span class="text-dark fw-bold fs-2hx" id="KpiTotalSold">-</span>
                    <span class="text-muted fs-8" id="KpiPeriodLabel"></span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body d-flex flex-column justify-content-center">
                    <span class="text-muted fw-semibold fs-7">@L("TotalPlanned")</span>
                    <span class="text-dark fw-bold fs-2hx" id="KpiTotalPlanned">-</span>
                    <span class="text-muted fs-8" id="KpiPlannedMonths"></span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body d-flex flex-column justify-content-center">
                    <span class="text-muted fw-semibold fs-7">@L("PercentageAchieved")</span>
                    <span class="fw-bold fs-2hx" id="KpiPercentAchieved">-</span>
                    <span class="fs-8" id="KpiVariance"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Sold vs planned per device type -->
    <div class="card mb-5">
        <div class="card-header">
            <h3 class="card-title">@L("SoldVsPlannedByDeviceType")</h3>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-row-bordered align-middle gy-3">
                    <thead>
                        <tr class="fw-bold text-muted">
                            <th>@L("DeviceType")</th>
                            <th class="w-25">@L("Sold") / @L("Planned")</th>
                            <th class="text-end">@L("Sold")</th>
                            <th class="text-end">@L("Planned")</th>
                            <th class="text-end">@L("Variance")</th>
                            <th class="text-end">@L("PercentageAchieved")</th>
                            <th class="text-end">@L("Cases")</th>
                            <th class="text-end">@L("Units")</th>
                        </tr>
                    </thead>
                    <tbody id="DeviceTypeBody"></tbody>
                </table>
            </div>
            <div class="text-muted fs-8 mt-2">@L("DeviceTypeTotalsUseLineAmounts")</div>
        </div>
    </div>

    <div class="row g-5 mb-5">
        <!-- Top 10 physicians -->
        <div class="col-xl-6">
            <div class="card h-100">
                <div class="card-header">
                    <h3 class="card-title">@L("TopPhysicianCollection")</h3>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-row-bordered align-middle gy-3">
                            <thead>
                                <tr class="fw-bold text-muted">
                                    <th>@L("Physician")</th>
                                    <th class="text-end">@L("Cases")</th>
                                    <th class="text-end">@L("Collection")</th>
                                    <th class="w-25">@L("ShareOfTotal")</th>
                                </tr>
                            </thead>
                            <tbody id="TopPhysiciansBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Top 10 hospitals -->
        <div class="col-xl-6">
            <div class="card h-100">
                <div class="card-header">
                    <h3 class="card-title">@L("TopHospitalCollection")</h3>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-row-bordered align-middle gy-3">
                            <thead>
                                <tr class="fw-bold text-muted">
                                    <th>@L("Hospital")</th>
                                    <th class="text-end">@L("Cases")</th>
                                    <th class="text-end">@L("Collection")</th>
                                    <th class="w-25">@L("ShareOfTotal")</th>
                                </tr>
                            </thead>
                            <tbody id="TopHospitalsBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Daily revenue -->
    <div class="card mb-5">
        <div class="card-header">
            <h3 class="card-title">@L("DailyRevenue")</h3>
            <div class="card-toolbar">
                <span class="text-muted fs-8">@L("RelativeToBusiestDay")</span>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-row-bordered align-middle gy-3">
                    <thead>
                        <tr class="fw-bold text-muted">
                            <th>@L("Date")</th>
                            <th class="text-end">@L("Cases")</th>
                            <th class="text-end">@L("Units")</th>
                            <th class="text-end">@L("Revenue")</th>
                            <th class="w-50"></th>
                        </tr>
                    </thead>
                    <tbody id="DailyRevenueBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>
