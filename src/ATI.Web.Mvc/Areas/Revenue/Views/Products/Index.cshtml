@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Products";
}

@section Scripts
{
    <script src="~/view-resources/Areas/Revenue/Views/Products/Index.js" asp-append-version="true"></script>
}

<div class="app-toolbar py-3 py-lg-6" id="kt_app_toolbar">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
            <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">
                Products
            </h1>
        </div>
        <div class="d-flex align-items-center">
            <button id="CreateNewProductButton" class="btn btn-primary">
                <i class="fa fa-plus btn-md-icon"></i>
                <span class="d-none d-md-inline-block">@L("CreateNew")</span>
            </button>
        </div>
    </div>
</div>

<div class="app-container container-fluid">
    <div class="card">
        <div class="card-body">
            <div class="form">
                <div class="row align-items-center mb-4">
                    <div class="col-xl-12">
                        <div class="mb-5 align-items-center">
                            <div class="input-group">
                                <input type="text" id="ProductsTableFilter" class="form-control" placeholder="@L("SearchWithThreeDot")">
                                <button id="GetProductsButton" class="btn btn-primary" type="submit">
                                    <i class="flaticon-search-1" aria-label="@L("Search")"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="AdvancedFiltersArea" style="display: none" class="row mb-4">
                    <div class="col-xl-4">
                        <div class="mb-5">
                            <label for="CategoryFilter" class="form-label">Category</label>
                            <select id="CategoryFilter" class="form-select">
                                <option value="">All Categories</option>
                                @foreach (var cat in (IEnumerable<SelectListItem>)ViewBag.Categories)
                                {
                                    <option value="@cat.Value">@cat.Text</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-xl-4">
                        <div class="mb-5">
                            <label for="SubcategoryFilter" class="form-label">Subcategory</label>
                            <select id="SubcategoryFilter" class="form-select">
                                <option value="">All Subcategories</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xl-12 text-end">
                        <button id="RefreshProductsButton" class="btn btn-primary float-end">
                            <i class="fa fa-sync btn-md-icon"></i>
                            <span class="d-none d-md-inline-block">@L("Refresh")</span>
                        </button>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-xl-12">
                        <span id="ShowAdvancedFiltersSpan" class="text-muted clickable-item">
                            <i class="fa fa-angle-down"></i> @L("ShowAdvancedFilters")
                        </span>
                        <span id="HideAdvancedFiltersSpan" class="text-muted clickable-item" style="display: none">
                            <i class="fa fa-angle-up"></i> @L("HideAdvancedFilters")
                        </span>
                    </div>
                </div>
            </div>

            <div class="align-items-center">
                <table id="ProductsTable" class="table align-middle table-row-dashed fs-6 gy-5 dataTable dtr-inline no-footer" width="100%">
                    <thead>
                        <tr>
                            <th>@L("Actions")</th>
                            <th>Product Code</th>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Subcategory</th>
                            <th>Manufacturer</th>
                            <th>Model No</th>
                            <th>Base Price</th>
                            <th>Cost</th>
                            <th>Price</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>
