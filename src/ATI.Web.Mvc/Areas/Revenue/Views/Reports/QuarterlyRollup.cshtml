@{
    ViewData["Title"] = "Quarterly Rollup";
    var currentYear = (int)ViewBag.CurrentYear;
}

@section Scripts
{
    <script src="~/view-resources/Areas/Revenue/Views/Reports/QuarterlyRollup.js" asp-append-version="true"></script>
}

<div class="app-toolbar py-3 py-lg-6">
    <div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
            <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">
                @L("QuarterlyRollup")
            </h1>
            <span class="text-muted me-4">Total Sold against Total Plan, by quarter and product category</span>
        </div>
    </div>
</div>

<div class="app-container container-fluid">
    <div class="card">
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-xl-3">
                    <div class="mb-5">
                        <label for="YearFilter" class="form-label">@L("Year")</label>
                        <select id="YearFilter" class="form-select">
                            @for (var year = currentYear + 1; year >= currentYear - 5; year--)
                            {
                                <option value="@year" selected="@(year == currentYear)">@year</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-xl-3">
                    <div class="mb-5">
                        <label for="QuarterFilter" class="form-label">@L("Quarter")</label>
                        <select id="QuarterFilter" class="form-select">
                            <option value="">@L("AllQuarters")</option>
                            <option value="1">Q1 (Jan - Mar)</option>
                            <option value="2">Q2 (Apr - Jun)</option>
                            <option value="3">Q3 (Jul - Sep)</option>
                            <option value="4">Q4 (Oct - Dec)</option>
                        </select>
                    </div>
                </div>
                <div class="col-xl-3">
                    <div class="mb-5">
                        <label for="HospitalFilter" class="form-label">@L("Hospital")</label>
                        <select id="HospitalFilter" class="form-select">
                            <option value="">@L("AllHospitals")</option>
                            @foreach (var hospital in ViewBag.Hospitals)
                            {
                                <option value="@hospital.Value">@hospital.Text</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-xl-3 d-flex align-items-end">
                    <div class="mb-5">
                        <button id="RunReportButton" class="btn btn-primary">
                            <i class="fa fa-search"></i> <span>@L("Show")</span>
                        </button>
                        <button id="ExportToExcelButton" class="btn btn-success ms-2">
                            <i class="fa fa-file-excel"></i> <span>@L("ExportToExcel")</span>
                        </button>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table id="QuarterlyRollupTable" class="table table-striped table-row-bordered gy-4 gs-7 align-middle w-100">
                    <thead>
                        <tr class="fw-bold fs-6 text-gray-800">
                            <th>@L("Quarter")</th>
                            <th>@L("Hospital")</th>
                            <th>@L("ProductCategory")</th>
                            <th class="text-end">Total Plan</th>
                            <th class="text-end">Total Sold</th>
                            <th class="text-end">@L("Variance")</th>
                            <th class="text-end">% to Plan</th>
                            <th class="text-center">@L("Cases")</th>
                            <th class="text-center">Units</th>
                            <th class="text-center">De Novo</th>
                            <th class="text-center">Gen Change</th>
                        </tr>
                    </thead>
                    <tbody id="QuarterlyRollupTableBody">
                        <tr><td colspan="11" class="text-center">@L("Show") a year to run the report</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
