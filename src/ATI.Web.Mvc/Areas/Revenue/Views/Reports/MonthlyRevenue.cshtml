@{
    ViewData["Title"] = "Monthly Revenue Report";
}

<div class="app-toolbar py-3 py-lg-6">
    <div class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
            <h1 class="page-heading d-flex fw-bold fs-3 flex-column justify-content-center my-0">
                @L("MonthlyRevenue")
            </h1>
            <span class="text-muted me-4">Daily revenue by product category, for one month</span>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-2">
                        <label for="YearFilter">Year *</label>
                        <input type="number" id="YearFilter" class="form-control" value="@ViewBag.CurrentYear" />
                    </div>
                    <div class="col-md-2">
                        <label for="MonthFilter">Month *</label>
                        <select id="MonthFilter" class="form-control">
                            @for (int i = 1; i <= 12; i++)
                            {
                                <option value="@i" selected="@(i == ViewBag.CurrentMonth)">@(new DateTime(2000, i, 1).ToString("MMMM"))</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="HospitalFilter">Hospital (Optional)</label>
                        <select id="HospitalFilter" class="form-control">
                            <option value="">All Hospitals</option>
                            @foreach (var hospital in ViewBag.Hospitals)
                            {
                                <option value="@hospital.Value">@hospital.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-auto d-flex align-items-end">
                        <button id="GenerateReportButton" class="btn btn-primary text-nowrap">
                            <i class="fas fa-chart-bar"></i> Generate Report
                        </button>
                        <button id="ExportToExcelButton" class="btn btn-success ms-2 text-nowrap">
                            <i class="fa fa-file-excel"></i> <span>@L("ExportToExcel")</span>
                        </button>
                    </div>
                </div>

                <div id="reportContainer" style="display:none;">
                    <table id="MonthlyRevenueTable" class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Product Category</th>
                                <th>Transaction Count</th>
                                <th class="text-center">Units</th>
                                <th>Daily Revenue</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/view-resources/Areas/Revenue/Views/Reports/MonthlyRevenue.js" asp-append-version="true"></script>
}
