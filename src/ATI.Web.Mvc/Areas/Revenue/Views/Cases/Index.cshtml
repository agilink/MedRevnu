@model ATI.Revenue.Application.Cases.Dtos.GetAllCasesInput
@{
    ViewData["Title"] = "Cases";
}

@section Scripts
{
    <script src="~/view-resources/Areas/Revenue/Views/Cases/Index.js" asp-append-version="true"></script>
}

<abp-page-subheader title="@L("Cases")" description="@L("CasesHeaderInfo")">
    <button id="RefreshCasesButton" class="btn btn-outline btn-outline-primary btn-active-light-primary me-1">
        <i class="fa fa-sync btn-md-icon"></i>
        <span class="d-none d-md-inline-block">
            @L("Refresh")
        </span>
    </button>
    <button id="CreateNewCaseButton" class="btn btn-primary">
        <i class="fa fa-plus btn-md-icon"></i>
        <span class="d-none d-md-inline-block">
            @L("CreateNewCase")
        </span>
    </button>
</abp-page-subheader>

<div class="app-container container-fluid">
    <div class="card">
        <div class="card-body">
            <div class="form">
                <div class="row align-items-center mb-4">
                    <div class="col-xl-12">
                        <div class="mb-5 align-items-center">
                            <div class="input-group">
                                <input type="text" id="CasesTableFilter" class="form-control" placeholder="@L("SearchWithThreeDot")">
                                <button id="GetCasesButton" class="btn btn-primary" type="submit">
                                    <i class="flaticon-search-1" aria-label="@L("Search")"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="AdvancedAuditFiltersArea" style="display: none" class="row mb-4">
                    <div class="col-xl-4">
                        <div class="mb-5">
                            <label for="CaseNumberFilter" class="form-label">@L("CaseNumber")</label>
                            <input type="text" id="CaseNumberFilter" class="form-control" placeholder="@L("CaseNumber")" />
                        </div>
                    </div>
                    <div class="col-xl-4">
                        <div class="mb-5">
                            <label for="ClientNameFilter" class="form-label">@L("ClientName")</label>
                            <input type="text" id="ClientNameFilter" class="form-control" placeholder="@L("ClientName")" />
                        </div>
                    </div>
                    <div class="col-xl-4">
                        <div class="mb-5">
                            <label for="StatusFilter" class="form-label">@L("Status")</label>
                            <select id="StatusFilter" class="form-control">
                                <option value="">@L("AllStatus")</option>
                                <option value="Open">@L("Open")</option>
                                <option value="In Progress">@L("InProgress")</option>
                                <option value="Closed">@L("Closed")</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xl-4">
                        <div class="mb-5">
                            <label for="ProcedureTypeFilter" class="form-label">@L("ProcedureType")</label>
                            <select id="ProcedureTypeFilter" class="form-control">
                                <option value="">@L("AllProcedureTypes")</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xl-4">
                        <div class="mb-5">
                            <label for="SurgeonNameFilter" class="form-label">@L("SurgeonName")</label>
                            <input type="text" id="SurgeonNameFilter" class="form-control" placeholder="@L("SurgeonName")" />
                        </div>
                    </div>
                    <div class="col-xl-4">
                        <div class="mb-5">
                            <label for="FacilityFilter" class="form-label">@L("Facility")</label>
                            <select id="FacilityFilter" class="form-control">
                                <option value="">@L("AllFacilities")</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xl-4">
                        <div class="mb-5">
                            <label for="ProcedureDateFilter" class="form-label">@L("ProcedureDate")</label>
                            <input type="date" id="ProcedureDateFilter" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="row mb-4">
                    <div class="col-xl-12">
                        <span id="ShowAdvancedFiltersSpan" class="text-muted clickable-item">
                            <i class="fa fa-angle-down"></i> @L("ShowAdvancedFilters")
                        </span>
                        <span id="HideAdvancedFiltersSpan" class="text-muted clickable-item" style="display: none">
                            <i class="fa fa-angle-up"></i> @L("HideAdvancedFilters")
                        </span>
                    </div>
                </div>
            </div>

            <div class="align-items-center">
                <table id="CasesTable" class="table align-middle table-row-dashed fs-6 gy-5 dataTable no-footer" width="100%">
                    <thead>
                        <tr>
                            <th>@L("CaseNumber")</th>
                            <th>@L("ClientName")</th>
                            <th>@L("ProcedureType")</th>
                            <th>@L("Surgeon")</th>
                            <th>@L("CaseDate")</th>
                            <th>@L("TotalAmount")</th>
                            <th>@L("Status")</th>
                            <th>@L("Actions")</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>