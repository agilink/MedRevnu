@using ATI.Revenue.Web.PageModel.Cases
@model CreateOrEditCaseModalViewModel

<div class="modal-header">
    <h5 class="modal-title">
        <span>@(Model.IsEditMode ? L("EditCase") : L("CreateNewCase"))</span>
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
</div>

<div class="modal-body">
    <form name="CaseCreateOrEditForm" role="form" novalidate class="form-validation">
        <input type="hidden" name="Id" value="@(Model.Case?.Id ?? 0)" />

        <div class="row">
            <div class="col-md-6">
                <div class="mb-5">
                    <label class="form-label required" for="CaseNumber">@L("CaseNumber")</label>
                    <input class="form-control" type="text" name="CaseNumber" id="CaseNumber" value="@(Model.Case?.CaseNumber ?? string.Empty)" required maxlength="50" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-5">
                    <label class="form-label required" for="ClientName">@L("ClientName")</label>
                    <input class="form-control" type="text" name="ClientName" id="ClientName" value="@(Model.Case?.ClientName ?? string.Empty)" required maxlength="200" />
                </div>
            </div>
        </div>

        <div class="mb-5">
            <label class="form-label" for="Description">@L("Description")</label>
            <textarea class="form-control" name="Description" id="Description" rows="3" maxlength="500">@(Model.Case?.Description ?? string.Empty)</textarea>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="mb-5">
                    <label class="form-label required" for="CaseDate">@L("CaseDate")</label>
                    <input class="form-control" type="date" name="CaseDate" id="CaseDate" value="@(Model.Case?.CaseDate.ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-MM-dd"))" required />
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-5">
                    <label class="form-label" for="ProcedureDate">@L("ProcedureDate")</label>
                    <input class="form-control" type="date" name="ProcedureDate" id="ProcedureDate" value="@(Model.Case?.ProcedureDate?.ToString("yyyy-MM-dd") ?? string.Empty)" />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="mb-5">
                    <label class="form-label" for="ProcedureTypeId">@L("ProcedureType")</label>
                    <select class="form-select" id="ProcedureTypeId" name="ProcedureTypeId"
                            data-current-id="@(Model.Case?.ProcedureTypeId?.ToString() ?? "")">
                        <option value="">-- Select Procedure Type --</option>
                    </select>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-5">
                    <label class="form-label" for="FacilityId">Hospital</label>
                    <select class="form-select" id="FacilityId" name="FacilityId"
                            data-current-id="@(Model.Case?.FacilityId?.ToString() ?? "")">
                        <option value="">-- Select Hospital --</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="mb-5">
                    <label class="form-label" for="SurgeonName">@L("SurgeonName")</label>
                    <select class="form-select" id="SurgeonName" name="SurgeonName"
                            data-current-name="@(Model.Case?.SurgeonName ?? "")">
                        <option value="">-- Select Surgeon --</option>
                    </select>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-5">
                    <label class="form-label" for="TotalAmount">@L("TotalAmount")</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input class="form-control" type="number" name="TotalAmount" id="TotalAmount" value="@(Model.Case?.TotalAmount ?? 0)" step="0.01" min="0" />
                    </div>
                </div>
            </div>
        </div>

        <div class="mb-5">
            <label class="form-label required" for="Status">@L("Status")</label>
            @{
                var currentStatus = Model.Case?.Status ?? "Open";
            }
            <select class="form-select" name="Status" id="Status" required
                    data-current-status="@currentStatus">
                <option value="Open">@L("Open")</option>
                <option value="In Progress">@L("InProgress")</option>
                <option value="Closed">@L("Closed")</option>
            </select>
        </div>

        <div class="mb-5">
            <label class="form-label" for="Notes">@L("Notes")</label>
            <textarea class="form-control" name="Notes" id="Notes" rows="3" maxlength="1000">@(Model.Case?.Notes ?? string.Empty)</textarea>
        </div>
    </form>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L("Cancel")</button>
    <button type="button" class="btn btn-primary save-button">
        <i class="fa fa-save"></i> <span>@L("Save")</span>
    </button>
</div>

<script src="~/view-resources/Areas/Revenue/Views/Cases/_CreateOrEditModal.js" asp-append-version="true"></script>
