@using ATI.Authorization
@{
    ViewData["Title"] = "Hospitals";
}

@section Scripts
{
    <script src="~/view-resources/Areas/Revenue/Views/Hospitals/Index.js" asp-append-version="true"></script>
}

<div class="app-toolbar py-3 py-lg-6" id="kt_app_toolbar">
    <div id="kt_app_toolbar_container" class="app-container container-fluid d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
            <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">
                @L("Hospitals")
            </h1>
            <span class="text-muted me-4">@L("HospitalsHeaderInfo")</span>
        </div>
        <div class="d-flex align-items-center">
            @if (IsGranted(AppPermissions.Pages_Revenue_Hospitals_Create))
            {
                <button id="CreateNewHospitalButton" class="btn btn-primary">
                    <i class="fa fa-plus btn-md-icon"></i>
                    <span class="d-none d-md-inline-block">@L("CreateNew")</span>
                </button>
            }
        </div>
    </div>
</div>

<div class="app-container container-fluid">
    <div class="card">
        <div class="card-body">
            <div class="d-flex justify-content-end mb-3 search-box-compact">
                <div class="input-group input-group-sm" style="max-width: 260px;">
                    <input type="text" id="HospitalsTableFilter" class="form-control form-control-sm"
                           placeholder="@L("SearchWithThreeDot")">
                    <button id="GetHospitalsButton" class="btn btn-sm btn-primary" type="submit">
                        <i class="flaticon-search-1" aria-label="@L("Search")"></i>
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table id="HospitalsTable" class="table table-striped table-row-bordered gy-4 gs-7 align-middle w-100">
                    <thead>
                        <tr class="fw-bold fs-6 text-gray-800">
                            <th>@L("Actions")</th>
                            <th>@L("HospitalName")</th>
                            <th>@L("Company")</th>
                            <th>@L("PhysicianCount")</th>
                            <th>@L("ProductPriceCount")</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>
